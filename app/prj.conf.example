# GPS Tracker application configuration.
# Combines the nfed `gps` (GNSS) and `https` (LTE + sockets + cJSON) sample configs.
#
# Template: copy to `prj.conf` and fill in the device key. `prj.conf` is
# gitignored so the key never lands in version control.
#
#     cp app/prj.conf.example app/prj.conf

# --- Cloud provider -----------------------------------------------------
# "nrfcloud" or "hologram". This one line is the whole switch; every
# provider-specific option below stays valid either way.
#
# "nrfcloud" needs per-device credentials in the modem key store - see the
# README "Provisioning" section. It is also the only provider that can serve
# A-GNSS assistance.
CONFIG_TRACKER_CLOUD_PROVIDER="hologram"

# Only used with the "hologram" provider. The 8-character "SIM Key" from the
# dashboard: device -> Webhooks tab -> Webhook key -> Show key. Not the numeric
# device ID, and not the account REST API key.
CONFIG_HOLOGRAM_DEVICE_KEY="CHANGEME"

# General / C library
CONFIG_FPU=y
CONFIG_NEWLIB_LIBC=y
CONFIG_NEWLIB_LIBC_FLOAT_PRINTF=y
CONFIG_STDOUT_CONSOLE=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# Heap and stacks. The heap serves nrf_cloud's allocator: a ~700 byte JWT per
# connect plus cJSON/zcbor scratch. The 4 KB A-GNSS buffer is static, not stacked.
# The system workqueue also runs the NMEA chat parser for the external GNSS.
CONFIG_HEAP_MEM_POOL_SIZE=20480
CONFIG_MAIN_STACK_SIZE=8192
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=4096

# --- External GNSS module (Adafruit Ultimate GPS v3) --------------------
# Zephyr's generic NMEA driver on uart1; see the board overlay for the node and
# app/Kconfig for the power pin and timings. PM_DEVICE lets the UART be parked
# between cycles so it neither burns current nor back-feeds the powered-down
# module through its TX pin.
CONFIG_GNSS=y
CONFIG_GNSS_NMEA_GENERIC=y
CONFIG_PM_DEVICE=y

# Modem library
CONFIG_NRF_MODEM_LIB=y
CONFIG_MODEM_INFO=y
CONFIG_MODEM_INFO_ADD_NETWORK=y

# LTE link control: LTE-M with GNSS coexistence
CONFIG_LTE_LINK_CONTROL=y
CONFIG_LTE_NETWORK_MODE_LTE_M_GPS=y

# Power saving mode (PSM). Requested periodic TAU 8h, active time 6s.
CONFIG_LTE_LC_PSM_MODULE=y
CONFIG_LTE_PSM_REQ=y
CONFIG_LTE_PSM_REQ_RPTAU="00101000"
CONFIG_LTE_PSM_REQ_RAT="00000011"
# Release Assistance Indication - drop to idle immediately after the final send.
CONFIG_LTE_LC_RAI_MODULE=y

# Networking - offloaded BSD sockets on the modem
CONFIG_NETWORKING=y
CONFIG_NET_NATIVE=n
CONFIG_NET_SOCKETS=y
CONFIG_NET_SOCKETS_OFFLOAD=y
CONFIG_NET_IPV4=y
CONFIG_NET_IPV6=n
CONFIG_POSIX_API=y

# JSON payload building
CONFIG_CJSON_LIB=y

# --- nRF Cloud over CoAP ------------------------------------------------
# NRF_CLOUD, NRF_CLOUD_COAP, MODEM_JWT, MODEM_KEY_MGMT and DATE_TIME are
# selected by CONFIG_TRACKER_CLOUD_NRF_LIB, which is on regardless of the
# provider so that these settings stay valid in a "hologram" build too. Only
# cloud_nrf.c or cloud_hologram.c is compiled, and the linker drops whatever
# the chosen one does not reference.
CONFIG_NRF_CLOUD_SEC_TAG=16842753
CONFIG_NRF_CLOUD_CLIENT_ID_SRC_INTERNAL_UUID=y
CONFIG_NRF_CLOUD_COAP_KEEPOPEN=y
CONFIG_NRF_CLOUD_COAP_DOWNLOADS=n
CONFIG_NRF_CLOUD_PRINT_DETAILS=y

# A-GNSS assistance
CONFIG_NRF_CLOUD_AGNSS=y
CONFIG_NRF_CLOUD_AGNSS_FILTERED=y
CONFIG_NRF_CLOUD_AGNSS_ELEVATION_MASK=5

# CoAP client. The retransmit limits bound how long a lost packet can stall the
# report loop; a failed cycle is retried at the next wake anyway.
CONFIG_COAP_CLIENT_BLOCK_SIZE=1024
CONFIG_COAP_CLIENT_STACK_SIZE=6144
CONFIG_COAP_EXTENDED_OPTIONS_LEN_VALUE=64
CONFIG_COAP_MAX_RETRANSMIT=2
CONFIG_COAP_INIT_ACK_TIMEOUT_MS=4000

# Network time: needed to sign the JWT, and stamps "ts" on each report. Modem
# time only - NTP would add a UDP round trip we do not need.
CONFIG_DATE_TIME=y
CONFIG_DATE_TIME_MODEM=y
CONFIG_DATE_TIME_NTP=n

# PMIC / charger (nPM1300) and sensor API for battery + VBUS detection
CONFIG_I2C=y
CONFIG_SENSOR=y
CONFIG_MFD=y
CONFIG_REGULATOR=y

# --- Wake-on-motion (onboard LIS2DH accelerometer) ----------------------
# The trigger mode lives in a Kconfig choice and the filter option in a driver
# menu, so neither can be selected from TRACKER_MOTION_WAKE - they have to be
# set here. HP_FILTERS is not optional: without it the any-motion detector
# compares absolute acceleration, and the 1 g a stationary board already reads
# would hold the interrupt asserted permanently.
CONFIG_LIS2DH_TRIGGER_GLOBAL_THREAD=y
CONFIG_LIS2DH_ACCEL_HP_FILTERS=y
CONFIG_LIS2DH_OPER_MODE_LOW_POWER=y

# Watchdog (~10 minute safety reset, mirrors the original hardware WDT)
CONFIG_WATCHDOG=y

# Logging
CONFIG_LOG=y
CONFIG_NRF_CLOUD_LOG_LEVEL_INF=y
CONFIG_NRF_CLOUD_COAP_LOG_LEVEL_INF=y
CONFIG_NRF_CLOUD_GPS_LOG_LEVEL_INF=y

# --- Bench testing without a SIM (uncomment both, rebuild, reflash) ---
# Leave commented for real/field use.
# GNSS-only, no cellular / no SIM required
#CONFIG_TRACKER_SKIP_LTE=y
# Log the composed message instead of sending it
#CONFIG_TRACKER_OFFLINE_DEBUG=y

# --- Board identity reported in the telemetry "hw" field ---------------
# Paired with "fw", the UTC build time, which is stamped in automatically.
# Nothing uses these yet; they are there so a future firmware or board revision
# can be told apart in the archive without guessing from dates.
CONFIG_TRACKER_HW_REVISION="feather-nrf9151"

# --- Always report, even with no GNSS fix (coords are sent as [0, 0]) ---
CONFIG_TRACKER_FORCE_PUBLISH_WITHOUT_FIX=y

# --- Also plot the device on the nRF Cloud portal map (extra message/report) ---
CONFIG_TRACKER_NRF_CLOUD_PORTAL_LOCATION=y
